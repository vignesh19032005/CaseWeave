# Two ways to run this:
#
# 1) Cloned from GitHub / a different machine: copy this file to .env and
#    fill in your own keys below. That's it — secrets_store.py reads this
#    file as a fallback automatically, no other setup needed.
#
# 2) This dev machine: secrets already live in Windows Credential Manager
#    (via secrets_store.py), so .env isn't needed here and isn't present.
#    To add/update a key this way instead:
#      python -c "from secrets_store import set_secret; set_secret('GROQ_API_KEY', 'your-key')"
#
# Lookup order: real env vars > Windows Credential Manager > this .env file.
# Leave a key blank to skip that provider; the fallback chain in
# llm_client.py tries the next one (Meta -> Groq -> Gemini).

META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

GROQ_API_KEY=
# The request sends reasoning_effort, which only the gpt-oss models accept.
GROQ_MODEL=openai/gpt-oss-20b

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

HUGGINGFACE_API_KEY=

# ALLOWED_ORIGINS: Comma-separated CORS origins for web access.
# Defaults to http://localhost:3000,http://127.0.0.1:3000 if blank.
# For police station LAN or remote testing, add your workstation/server IP, e.g.:
# ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.100:3000
ALLOWED_ORIGINS=

# JWT_SECRET: leave blank — auto-generated and stored on first run.
# Only set this manually if you need a fixed value across reinstalls.
JWT_SECRET=

# LLM_PROVIDER_MODE: which AI providers may be used.
#   auto        (default) Meta's hosted models first. If Meta cannot answer: the local model below.
#               If that is not available either: Groq, then Gemini (when their keys are set).
#   meta_only   only Meta's hosted models; nothing is ever sent anywhere else
#   local_only  only the local model (everything stays on this machine or the department's server)
LLM_PROVIDER_MODE=auto

# The local model: any OpenAI-compatible server (Ollama, vLLM, llama.cpp), used as the first fallback.
# Example with Ollama and a Meta Llama model:   ollama pull llama3.1:8b
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# For long case prompts use a copy of the model with a 16k context window (ollama create llama3.1-8b-16k, with PARAMETER num_ctx 16384): the default window truncates them.
LOCAL_LLM_MODEL=llama3.1:8b
LOCAL_LLM_API_KEY=

# --- Accounts -------------------------------------------------------------
# CASEWEAVE_ADMIN_PASSWORD: password for the first "admin" account, used only when the users table is empty.
# If it is blank the account is created with the shipped default password and is FORCED to change it at first
# sign-in (any existing account still on the default is forced the same way when the API starts).
CASEWEAVE_ADMIN_PASSWORD=

# --- Infrastructure -------------------------------------------------------
# REDIS_PASSWORD: set this if your Redis requires AUTH (it should, anywhere other than a single workstation).
REDIS_PASSWORD=
# CASEWEAVE_BACKUP_DIR: where the single standing backup is kept (default: Desktop/CaseWeave_Backup).
# MYSQLDUMP_PATH: full path to mysqldump if it is not on PATH.  FFMPEG_CMD / TESSERACT_CMD likewise.
# TESSERACT_LANGS: OCR languages, e.g. eng+tam+hin (installed language packs are detected automatically).
# CW_PDF_FONT: a TrueType font with Tamil/Devanagari glyphs for the PDFs (Nirmala UI / Noto Sans are found automatically).

# --- Privacy --------------------------------------------------------------
# Names of people the analysis has resolved, and phone numbers, e-mails, Aadhaar, PAN, vehicle plates, IMEI and long
# account-like numbers are replaced by placeholders before case text is sent to a model (and restored on return).
# Set to 0 only for local_only mode. Place names and anything inside images are never redacted.
SANDBOX_REDACT_PII=1
# LLM_CALL_PACING_S: seconds to wait between sequential model calls (rate-limit friendliness). Default 1.
