# Two ways to run this:
#
# 1) Cloned from GitHub / a different machine: copy this file to .env and
#    fill in your own keys below. That's it — secrets_store.py reads this
#    file as a fallback automatically, no other setup needed.
#
# 2) This dev machine: secrets already live in Windows Credential Manager
#    (via secrets_store.py), so .env isn't needed here and isn't present.
#    To add/update a key this way instead:
#      python -c "from secrets_store import set_secret; set_secret('GROQ_API_KEY', 'your-key')"
#
# Lookup order: real env vars > Windows Credential Manager > this .env file.
# Leave a key blank to skip that provider; the fallback chain in
# llm_client.py tries the next one (Meta -> Groq -> Gemini).

META_API_KEY=
META_API_BASE_URL=https://api.llama.com/v1

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

HUGGINGFACE_API_KEY=

# JWT_SECRET: leave blank — auto-generated and stored on first run.
# Only set this manually if you need a fixed value across reinstalls.
JWT_SECRET=
